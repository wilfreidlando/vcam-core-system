APP_NAME="Core System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Core environment ────────────────────────────────────────────────────────
# Credential-level environment, distinct from APP_ENV. Sandbox and live data,
# credentials and effects are fully isolated; no real money moves in sandbox.
# Deployed environments: sandbox · staging · live.
CORE_ENVIRONMENT=sandbox

# ─── Observability ──────────────────────────────────────────────────────────
# Structured JSON logs, correlated end to end. Never plain text in deployed
# environments: every record must be machine-queryable by correlation_id.
LOG_CHANNEL=structured
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# PostgreSQL only (ADR-0003): the ledger relies on row locks, deferred
# constraint triggers and exclusion constraints that SQLite cannot express.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=core
DB_USERNAME=core
DB_PASSWORD=secret
DB_PORT_HOST=55432

# ─── Valkey (Redis-compatible) ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PORT_HOST=56379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Mail (Mailpit in local) ────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="core@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025

# ─── Object storage (S3-compatible, `--profile storage`) ────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
MINIO_USER=core
MINIO_PASSWORD=secret1234
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Provider credentials ───────────────────────────────────────────────────
# Never commit real values. In deployed environments these come from the
# infrastructure secrets manager and are encrypted at rest per project and
# per environment (spec technique §14).
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

WHATSAPP_BASE_URL=
WHATSAPP_TOKEN=
