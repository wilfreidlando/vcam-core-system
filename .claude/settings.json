{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(vendor/bin/pest *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/deptrac *)",
      "Bash(vendor/bin/pint *)",
      "Bash(php artisan *)",
      "Bash(composer install *)",
      "Bash(composer dump-autoload *)",
      "Bash(composer validate *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(composer require *)",
      "Bash(composer update *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.sandbox)",
      "Read(./.env.live)",
      "Read(./storage/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/quality-check.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
