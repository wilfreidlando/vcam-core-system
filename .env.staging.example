# STAGING template (ADR-0064) — copy to `.env.staging` in the STAGING
# checkout on the VPS. Same application as production, isolated stack:
# its own containers, database, volumes, keys and host name. Never put
# production secrets or real provider credentials here.
#
# Unlike .env.example (local dev), there is no .env file inside the image:
# .dockerignore excludes it, so every one of these reaches Laravel purely as
# a process environment variable via `env_file:` in compose.prod.yaml.

APP_NAME="Core System"
APP_ENV=production
# Generate once, keep stable forever after: rotating it invalidates every
# encrypted session/cookie and every Crypt-encrypted secret already stored
# in the database (webhook endpoint secrets, provider application
# credentials — see packages/webhook, packages/payment). Generate locally
# with `php artisan key:generate --show` (prints without writing a file)
# and paste the result here — never run key:generate against this file in
# place, since there's no on-disk .env in the running container to update.
APP_KEY=
APP_DEBUG=false
# Literal, not interpolated from CORE_PUBLIC_HOST below — Dotenv only resolves
# ${VAR} references to a variable already defined earlier in the file, and
# getting that ordering right silently is not worth the one extra line.
APP_URL=https://core-system-staging.visibilitycam.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Never true outside local dev — see config/identity.php and the comments
# in .env.example for what each of these actually does.
IDENTITY_DISABLE_TOTP_IN_LOCAL=false
IDENTITY_DISABLE_MFA=false

# sandbox | staging | live — spec technique §14. Real money only moves when
# this is `live`.
CORE_ENVIRONMENT=sandbox

LOG_CHANNEL=structured
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=core
DB_USERNAME=core
# Generate a real secret — `openssl rand -base64 32`, for example.
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The admin console's session cookie must never leave the wire in the clear.
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Mail ─────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ─── Provider credentials ───────────────────────────────────────────────────
# Real values only — never commit them. These are the platform-level
# provider credentials; per-Project MyCoolPay applications are registered
# separately (payment:register-provider-application / the admin console),
# not set here.
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# ─── WhatsApp (WAHA, auto-hébergé) ─────────────────────────────────────────
# Sans WAHA_API_KEY, chaque envoi WhatsApp finit en `failed` avec
# « API key auth for "whatsapp-waha" requires a non-empty api_key credential ».
# WAHA_BASE_URL : l'adresse de VOTRE instance WAHA, joignable depuis le
# conteneur app (pas localhost — dans le conteneur, localhost c'est le Core).
WAHA_BASE_URL=
WAHA_API_KEY=
# Même valeur que celle configurée côté WAHA pour l'en-tête X-Webhook-Secret
# de ses webhooks entrants (POST /webhooks/whatsapp-waha).
WAHA_WEBHOOK_SECRET=

# ─── Core Admin ─────────────────────────────────────────────────────────────
OPERATOR_TOKEN_TTL_MINUTES=480
PAYMENT_RECONCILIATION_STUCK_AFTER_MINUTES=15
PAYMENT_RECONCILIATION_BATCH_SIZE=100

# ─── VPS standard (vcam-infra-deploy, ADR-0064) ───────────────────────────────
# Identity of this stack on the VPS. Production keeps the historical names.
DEPLOYMENT=staging
STACK_PREFIX=core-system-staging
CORE_ENV_FILE=.env.staging
# Public name of this stack. Deliberately NOT called VIRTUAL_HOST: this file
# is loaded into every container (env_file), and only the `webserver` sidecar
# may declare itself to nginx-proxy (compose.prod.yaml maps it).
CORE_PUBLIC_HOST=core-system-staging.visibilitycam.com
LETSENCRYPT_EMAIL=ops@visibilitycam.com

# Proves to the app that forwarded headers come from its own nginx sidecar,
# not from another container on the shared `observability` network.
# openssl rand -hex 32 — different for staging.
TRUSTED_PROXY_TOKEN=

# Resource limits (the VPS is shared — never leave a container unbounded).
APP_CPUS=0.5
APP_MEMORY=512M
HORIZON_CPUS=0.5
HORIZON_MEMORY=384M
SCHEDULER_CPUS=0.25
SCHEDULER_MEMORY=256M
POSTGRES_CPUS=0.5
POSTGRES_MEMORY=512M
VALKEY_MEMORY=128M

# Shared observability (vcam-infra-deploy/observability).
OTEL_SERVICE_NAME=core-system-staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-alloy:4318
GRAFANA_URL=https://grafana.visibilitycam.com

# Backups (vcam-infra-deploy/images/db-backup) — MEGA S4 or any S3-compatible storage.
# Platform clone on this machine (backup image build context); default shown.
# PLATFORM_DIR=/app/vps-platform
# Keep BACKUP_PASSPHRASE in a password manager too: without it, no restore.
BACKUP_PASSPHRASE=
BACKUP_TIME=03:00
BACKUP_LOCAL_KEEP=7
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.s4.mega.io
# Staging: local copies only, unless you want them off-site too.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
