{
    "openapi": "3.1.0",
    "info": {
        "title": "Core System API",
        "version": "v1",
        "description": "Enterprise Core System \u2014 capacit\u00e9s transverses (identity, ledger, wallet) expos\u00e9es \u00e0 plusieurs produits. Authentification par API key (`Authorization: Bearer pk_<env>_<id>.<secret>`), voir `GET /v1/whoami`."
    },
    "servers": [
        {
            "url": "http://localhost:8000/v1"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/webhook-endpoints/{endpointId}": {
            "delete": {
                "operationId": "webhook-endpoints.deactivate",
                "description": "Stops future deliveries; already-scheduled retries for deliveries\ncreated before deactivation still run to completion or DLQ.\nRequires the `webhooks:write` scope.",
                "summary": "Deactivate a webhook endpoint",
                "tags": [
                    "DeactivateWebhookEndpoint"
                ],
                "parameters": [
                    {
                        "name": "endpointId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    }
                }
            }
        },
        "/payments/{paymentId}": {
            "get": {
                "operationId": "payments.status",
                "description": "Reads the Core's own last-known state only \u2014 no live call to the\nprovider. Requires the `payments:read` scope, and returns the same\nnot-found response whether the payment doesn't exist or belongs to\nanother project.",
                "summary": "Get a payment's current status",
                "tags": [
                    "GetPaymentStatus"
                ],
                "parameters": [
                    {
                        "name": "paymentId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "channel": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "amount": {
                                            "type": "integer"
                                        },
                                        "currency": {
                                            "type": "string"
                                        },
                                        "requires_action": {
                                            "type": "boolean"
                                        },
                                        "action_hint": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "payment_url": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "error_message": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "channel",
                                        "status",
                                        "amount",
                                        "currency",
                                        "requires_action",
                                        "action_hint",
                                        "payment_url",
                                        "error_message"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    }
                }
            }
        },
        "/webhook-endpoints": {
            "get": {
                "operationId": "webhook-endpoints.list",
                "description": "Never includes the signing secret \u2014 it is shown once, at\nregistration, and never again. Requires the `webhooks:read` scope.",
                "summary": "List the calling Project's webhook endpoints",
                "tags": [
                    "ListWebhookEndpoints"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "operationId": "webhook-endpoints.register",
                "description": "The returned `secret` signs every delivery to this endpoint\n(`X-Signature`/`X-Timestamp` headers, HMAC-SHA256) and is shown\nexactly once \u2014 store it, it cannot be retrieved again. Requires the\n`webhooks:write` scope.",
                "summary": "Register a webhook endpoint",
                "tags": [
                    "RegisterWebhookEndpoint"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterWebhookEndpointRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "url": {
                                            "type": "string"
                                        },
                                        "events": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "secret": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "url",
                                        "events",
                                        "secret"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/payments": {
            "post": {
                "operationId": "payments.start",
                "description": "The request names only a `channel` (e.g. `mtn_momo`, `card`), never a\nprovider \u2014 `StartPaymentUseCase` resolves which adapter actually\nhandles it via the Project's routing configuration (ADR-0038 \u00a72).\nRequires the `payments:write` scope and an `Idempotency-Key` header\n(G7, ADR-0025). Crediting a wallet on success is never implicit \u2014 it\nonly happens if `wallet_recipient_external_ref` is given (ADR-0037).",
                "summary": "Start a payment",
                "tags": [
                    "StartPayment"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StartPaymentRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "channel": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "amount": {
                                            "type": "integer"
                                        },
                                        "currency": {
                                            "type": "string"
                                        },
                                        "requires_action": {
                                            "type": "boolean"
                                        },
                                        "action_hint": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "payment_url": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "channel",
                                        "status",
                                        "amount",
                                        "currency",
                                        "requires_action",
                                        "action_hint",
                                        "payment_url"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/wallets/{walletId}/balance": {
            "get": {
                "operationId": "wallet.balance",
                "description": "Read-only (ADR-0033 \u00a71): Wallet exposes no HTTP endpoint that mutates\na balance. Requires the `wallets:read` scope, and returns the same\nnot-found response whether the wallet doesn't exist or belongs to\nanother project \u2014 the two are indistinguishable on purpose.",
                "summary": "Get a wallet's balance",
                "tags": [
                    "WalletBalance"
                ],
                "parameters": [
                    {
                        "name": "walletId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "wallet_id": {
                                            "type": "string"
                                        },
                                        "currency": {
                                            "type": "string"
                                        },
                                        "available_minor": {
                                            "type": "integer"
                                        },
                                        "held_minor": {
                                            "type": "integer"
                                        }
                                    },
                                    "required": [
                                        "wallet_id",
                                        "currency",
                                        "available_minor",
                                        "held_minor"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    }
                }
            }
        },
        "/whoami": {
            "get": {
                "operationId": "identity.whoami",
                "description": "Resolves the bearer API key and returns which Project it belongs to,\nin which environment (sandbox/live), and which scopes it carries. The\nfirst call an integrating product should make to confirm its\ncredentials.",
                "summary": "Identify the calling Project",
                "tags": [
                    "WhoAmI"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "project_id": {
                                            "type": "string"
                                        },
                                        "organization_id": {
                                            "type": "string"
                                        },
                                        "environment": {
                                            "type": "string"
                                        },
                                        "scopes": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "required": [
                                        "project_id",
                                        "organization_id",
                                        "environment",
                                        "scopes"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "pk_<env>_<id>.<secret>"
            }
        },
        "schemas": {
            "PaymentFlow": {
                "type": "string",
                "description": "Discriminates between the two payment initiation flows exposed by aggregator-style providers. `Payin` is the synchronous, app-driven flow (used by mobile apps and server-to-server integrations that drive the customer through their own UX). MyCoolPay exposes this as `POST /payin`; CinetPay exposes it as `POST /v2/payment`; MTN exposes it as `POST /collection/.../requesttopay`.  `Paylink` is the hosted-link, redirect-driven flow (used by web apps that hand the customer off to a provider-hosted page). MyCoolPay exposes this as `POST /paylink`; CinetPay returns a `payment_url` alongside the same initiation call (the discriminator is implicit).  Providers that do not distinguish the two flows (e.g. CinetPay) treat `Payin` as the default and ignore the discriminator on the `InitiatePaymentCommand`.\n",
                "enum": [
                    "payin",
                    "paylink"
                ],
                "title": "PaymentFlow"
            },
            "RegisterWebhookEndpointRequest": {
                "type": "object",
                "description": "Validates `POST /v1/webhook-endpoints`. Authorization (the\n`webhooks:write` scope) is checked in the controller against\n`ProjectContext`, not here.",
                "properties": {
                    "url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "events": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 100
                        },
                        "minItems": 1
                    }
                },
                "required": [
                    "url",
                    "events"
                ],
                "title": "RegisterWebhookEndpointRequest"
            },
            "StartPaymentRequest": {
                "type": "object",
                "description": "Validates `POST /v1/payments`. Authorization (the `payments:write`\nscope) is checked in the controller against `ProjectContext`, not\nhere \u2014 this class only validates shape, never identity.\n\nNo `idempotency_key` body field: the `Idempotency-Key` HTTP header\n(required by the `idempotency` middleware ahead of this request ever\nreaching validation \u2014 ADR-0025, G7) is the one value used for both\nthe HTTP-level response cache and `StartPaymentUseCase`'s own\nprovider-call protection. One key, not two.\n\n`amount` is in minor units (e.g. cents) \u2014 never a decimal amount,\nmatching how it is stored (`bigint`, G5).",
                "properties": {
                    "channel": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "currency": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 3
                    },
                    "reason": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "customer_phone_number": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 32
                    },
                    "customer_name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "customer_email": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "email"
                    },
                    "customer_lang": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 8
                    },
                    "flow": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/PaymentFlow"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "return_url": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uri"
                    },
                    "wallet_recipient_external_ref": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    }
                },
                "required": [
                    "channel",
                    "amount",
                    "currency",
                    "reason"
                ],
                "title": "StartPaymentRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}