# Rendered to /etc/nginx/conf.d/app.conf by the nginx image at start
# (envsubst of defined env vars only — nginx's own $variables are untouched).
# Docker embedded DNS.
# `app` can receive a new IP whenever its container is recreated during
# deployment, so nginx must not permanently cache the IP resolved at startup.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    # Using a variable makes proxy_pass use the resolver above at runtime.
    set $app_upstream app:8000;

    location /up {
        access_log off;
        proxy_pass http://$app_upstream;
    }

    # ADR-0059: Prometheus scrapes /metrics on the internal network
    # (core-system-internal); it is never reachable from the Internet.
    location = /metrics {
        return 404;
    }

    location / {
        proxy_pass http://$app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # TLS is terminated by the shared nginx-proxy. Preserve the original
        # protocol instead of replacing it with this HTTP hop's scheme.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # ADR-0064 — proves to the app that the forwarded headers above come
        # from this sidecar, not from another container on the shared
        # `observability` network. Substituted at container start from the
        # TRUSTED_PROXY_TOKEN env var (nginx image templating).
        proxy_set_header X-Core-Proxy-Token "${TRUSTED_PROXY_TOKEN}";

        # Payment initiation can take ~17s at MyCoolPay, twice on a retry.
        proxy_read_timeout 90s;
        client_max_body_size 20m;
    }
}