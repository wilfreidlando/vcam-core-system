<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <!-- Architecture guardrails: boundaries, canonical statuses, idempotency,
             module graph. Fast, no database. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>

        <!-- Schema guardrails: anti-PII, money columns. Requires PostgreSQL. -->
        <testsuite name="Schema">
            <directory>tests/Schema</directory>
        </testsuite>

        <!-- Financial invariants: sum-zero, derived balances, concurrency,
             idempotent replay. Requires PostgreSQL. -->
        <testsuite name="Invariants">
            <directory>tests/Invariants</directory>
        </testsuite>

        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>

        <!-- The admin web console (session/cookie auth, Blade views) —
             distinct from Integration's bearer-token API tests. Was
             never actually registered here despite being referenced by
             an earlier commit's own message and a since-removed PHPStan
             exclusion comment as covering that code (review finding,
             Lot 6 follow-up): the directory existed, but php artisan
             test / vendor/bin/pest would never have discovered anything
             placed in it. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- Sectors — one bounded context, one agent, one test database.
             Each context tests itself: a sector agent runs its own suite
             (`make test-sector SECTOR=billing`) instead of the whole
             ninety-nine seconds. The integration gate runs them all. -->
        <testsuite name="billing">
            <directory>packages/billing/tests</directory>
        </testsuite>
        <testsuite name="payment">
            <directory>packages/payment/tests</directory>
        </testsuite>
        <testsuite name="identity">
            <directory>packages/identity/tests</directory>
        </testsuite>
        <testsuite name="ledger">
            <directory>packages/ledger/tests</directory>
        </testsuite>
        <testsuite name="wallet">
            <directory>packages/wallet/tests</directory>
        </testsuite>
        <testsuite name="parties">
            <directory>packages/parties/tests</directory>
        </testsuite>
        <testsuite name="notification">
            <directory>packages/notification/tests</directory>
        </testsuite>
        <testsuite name="webhook">
            <directory>packages/webhook/tests</directory>
        </testsuite>
        <testsuite name="events">
            <directory>packages/events/tests</directory>
        </testsuite>
        <testsuite name="audit">
            <directory>packages/audit/tests</directory>
        </testsuite>
        <testsuite name="admin">
            <directory>packages/admin/tests</directory>
        </testsuite>
        <testsuite name="support">
            <directory>packages/support/tests</directory>
        </testsuite>
        <testsuite name="fees">
            <directory>packages/fees/tests</directory>
        </testsuite>
        <testsuite name="storage">
            <directory>packages/storage/tests</directory>
        </testsuite>
        <testsuite name="developer-platform">
            <directory>packages/developer-platform/tests</directory>
        </testsuite>

        <!-- The application-level suites: they span several modules on
             purpose (the documented API examples, the console flows). -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
            <directory>packages/*/src</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- PostgreSQL, never SQLite: the ledger guardrails assert behaviour
             (row locking, deferred triggers, information_schema introspection)
             that SQLite cannot reproduce. A green SQLite run would be a lie. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="core_testing"/>
        <env name="DB_USERNAME" value="core"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="CORE_ENVIRONMENT" value="sandbox"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="EVENTS_RELAY_ON_COMMIT" value="false"/>
        <!-- Hermetic: a developer's own .env (the simulator is on in dev) must not change what the suite proves. -->
        <env name="PAYMENT_SIMULATOR_ENABLED" value="false" force="true"/>
        <!-- Connect-time SSRF re-check resolves real DNS; it is covered
             hermetically by GuardedHttpTransportTest instead. -->
        <env name="OUTBOUND_ENFORCE_AT_CONNECT" value="false"/>
        <!-- WAHA auth needs a non-empty key; tests must not depend on a
             developer .env to provide one. -->
        <env name="WAHA_API_KEY" value="test-waha-api-key"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="LOG_CHANNEL" value="stack"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Both MFA dev-convenience flags pinned off regardless of the
             developer's local .env — IDENTITY_DISABLE_MFA is explicitly
             NOT environment-gated in code (unlike DISABLE_TOTP_IN_LOCAL,
             which the ServiceProvider only honours under APP_ENV=local
             and so is already safe here; pinned anyway for defense in
             depth), so a local .env override otherwise leaks straight
             into the test run and silently skips the MFA step every
             test that expects it relies on. -->
        <env name="IDENTITY_DISABLE_TOTP_IN_LOCAL" value="false"/>
        <env name="IDENTITY_DISABLE_MFA" value="false"/>
    </php>
</phpunit>
