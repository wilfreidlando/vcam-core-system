# VPS standard (vcam-infra-deploy) — how /app/vps-platform/bin/deploy.sh deploys the Core.
# No secrets here: those live in .env (production) and .env.staging.
APP_NAME=core-system
COMPOSE_FILE=compose.prod.yaml
ENV_FILE_PROD=.env
ENV_FILE_STAGING=.env.staging
# Les branches du Core (décision du 2026-10-05) : le staging suit `develop` (le code à valider) ; la production ne reçoit QUE ce qui est déjà
# dans `main` : après la recette, on fusionne `develop` dans `main`, puis on promeut (l'image reste CELLE DU STAGING, jamais reconstruite).
# Une production n'est jamais déployée automatiquement. La garde (BRANCH_PROD) est lue dans la version déployée en production : elle s'active
# à partir de la première promotion qui porte cette ligne.
BRANCH_STAGING=develop
BRANCH_PROD=main

# /health/ready checks the database and Valkey (/up only checks the process).
# Deliberately not /ready, which also fails on outbox lag: a stuck
# relay must not make every deploy roll back.
HEALTH_SERVICE=app
HEALTH_CMD="curl -fsS http://127.0.0.1:8000/health/ready"
HEALTH_TIMEOUT=120

MIGRATE_SERVICE=app
MIGRATE_CMD="php artisan migrate --force"

BACKUP_SERVICE=backup
DB_SERVICE=postgres
