# VPS standard (vcam-infra-deployment) — how /app/vps-platform/bin/deploy.sh deploys the Core.
# No secrets here: those live in .env (production) and .env.staging.
APP_NAME=core-system
COMPOSE_FILE=compose.prod.yaml
ENV_FILE_PROD=.env
ENV_FILE_STAGING=.env.staging
STAGING_BRANCH=main

# /health/ready checks the database and Valkey (/up only checks the process).
# Deliberately not /ready, which also fails on outbox lag: a stuck
# relay must not make every deploy roll back.
HEALTH_SERVICE=app
HEALTH_CMD="curl -fsS http://127.0.0.1:8000/health/ready"
HEALTH_TIMEOUT=120

MIGRATE_SERVICE=app
MIGRATE_CMD="php artisan migrate --force"

BACKUP_SERVICE=backup
DB_SERVICE=postgres
