{
  "uid": "core-overview",
  "title": "Core — Vue d'ensemble",
  "tags": [
    "core-system"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Déploiement",
        "type": "custom",
        "query": "prod,staging",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Core joignable",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(core_up{deployment=\"$deployment\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Outbox — retard (s)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(core_outbox_oldest_unpublished_age_seconds{deployment=\"$deployment\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Webhooks en DLQ",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(core_webhook_deliveries{deployment=\"$deployment\",status=\"dead\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Voir les erreurs et avertissements du Core",
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bapp%3D%5C%22core-system%5C%22%2C%20deployment%3D%5C%22${deployment:percentencode}%5C%22%2C%20level%3D~%5C%22ERROR%7CCRITICAL%7CALERT%7CEMERGENCY%7CWARNING%5C%22%7D%22%2C%22queryType%22%3A%22range%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "description": "Livraisons de webhooks abandonnées après tous les essais. 0 = bon état. Si > 0 : console → Webhooks → DLQ (rejouer après correction du point d'arrivée du client). Les lignes concernées : cliquer sur le chiffre (ouvre Explore), ou le panneau « Erreurs et avertissements récents » juste dessous."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taux d'erreur 5xx (5 min)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(core_http_requests_total{deployment=\"$deployment\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(core_http_requests_total{deployment=\"$deployment\"}[5m])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit",
          "links": [
            {
              "title": "Voir les erreurs et avertissements du Core",
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bapp%3D%5C%22core-system%5C%22%2C%20deployment%3D%5C%22${deployment:percentencode}%5C%22%2C%20level%3D~%5C%22ERROR%7CCRITICAL%7CALERT%7CEMERGENCY%7CWARNING%5C%22%7D%22%2C%22queryType%22%3A%22range%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "description": "Part des réponses en erreur serveur (5xx) sur 5 minutes. 0 % = bon état (aucune erreur serveur). Les lignes concernées : cliquer sur le chiffre (ouvre Explore), ou le panneau « Erreurs et avertissements récents » juste dessous."
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Erreurs et avertissements récents",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"core-system\", deployment=\"$deployment\", service=~\"app|horizon|scheduler\", level=~\"ERROR|CRITICAL|ALERT|EMERGENCY|WARNING\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {}
      },
      "description": "Les lignes d'erreur et d'avertissement du Core. C'est ici qu'on lit le détail d'un chiffre du bandeau."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requêtes HTTP par route",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(core_http_requests_total{deployment=\"$deployment\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latence p95 par route",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(core_http_request_duration_seconds_bucket{deployment=\"$deployment\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Réponses par code",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(core_http_requests_total{deployment=\"$deployment\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Paiements créés (24 h) par statut",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (core_payments_last_24h{deployment=\"$deployment\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucun paiement créé sur 24 h"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "description": "Vide = aucune activité sur la période, ce n'est pas une panne."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Livraisons webhook par statut",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (core_webhook_deliveries{deployment=\"$deployment\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucune livraison de webhook"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "description": "Vide = aucune activité sur la période, ce n'est pas une panne."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Files Horizon (jobs en attente)",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (core_queue_size{deployment=\"$deployment\"})",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Notifications (24 h) par statut",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (core_notifications_last_24h{deployment=\"$deployment\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucune notification sur 24 h"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "description": "Vide = aucune activité sur la période, ce n'est pas une panne."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Outbox non relayé",
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(core_outbox_unpublished{deployment=\"$deployment\"})",
          "legendFormat": "lignes"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    }
  ]
}
