{
    "name": "core/billing",
    "description": "Commerce: the customers of a project, the versioned plan catalogue, and the subscription contracts with their periods (ADR-0070, ADR-0071, ADR-0072).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "core/support": "*@dev",
        "core/events": "*@dev",
        "core/identity": "*@dev",
        "core/ledger": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Core\\Billing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Core\\Billing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Core\\Billing\\BillingServiceProvider"
            ]
        }
    }
}
