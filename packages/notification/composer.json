{
    "name": "core/notification",
    "description": "Multi-channel notification orchestration (WhatsApp/SMS/email/push/in-app), versioned templates, provider adapters.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "core/support": "*@dev",
        "core/identity": "*@dev",
        "core/parties": "*@dev",
        "core/events": "*@dev"
    },
    "autoload": {
        "psr-4": {
            "Core\\Notification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Core\\Notification\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Core\\Notification\\NotificationServiceProvider"
            ]
        }
    }
}
