{
    "name": "core/identity",
    "description": "Organizations, Projects, API keys, OAuth clients, operators, RBAC.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "core/audit": "*@dev",
        "core/support": "*@dev"
    },
    "autoload": {
