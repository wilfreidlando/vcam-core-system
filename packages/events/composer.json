{
    "name": "core/events",
    "description": "Standardized event model, transactional outbox, relay and internal dispatch.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "core/support": "*@dev"
    },
    "autoload": {
        "psr-4": {
